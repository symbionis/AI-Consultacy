---
// One of the two offer pages (individuals, organisations), EN or FR.
// Order: hero (block), intro + five levels (page), the thread (band),
// the method with two boxes per step (page), closing line and booking.
// On each page, the box for its own audience comes first and is highlighted.
import Layout from '../layouts/Layout.astro';
import HeroShapes from './HeroShapes.astro';
import { FRANK_REF, SITE, pageUrl, type Locale } from '../i18n/ui';
import { offer, type Audience } from '../i18n/offer';
import '../styles/framework.css';

interface Props {
  locale: Locale;
  audience: Audience;
}

const { locale, audience } = Astro.props;
const c = offer[locale];
const page = c.pages[audience];
const pathKey = audience === 'individual' ? 'coaching' : 'organisations';
const other: Audience = audience === 'individual' ? 'organisation' : 'individual';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title.replace(' | Franksy', ''),
  description: page.description,
  inLanguage: locale,
  url: pageUrl(locale, pathKey),
  image: `${SITE}/og-image.png`,
  provider: FRANK_REF,
};
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  pathKey={pathKey}
  jsonLd={jsonLd}
>
  <section class="hero">
    <HeroShapes />
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1 class="display" set:html={page.h1} />
        <p class="hero-lede">{page.lede}</p>
      </div>
    </div>
  </section>

  <section class="section" id="levels">
    <div class="container">
      <div class="eyebrow"><span class="marker marker--square" aria-hidden="true"></span>{c.levels.eyebrow}</div>
      <h2 class="h1 section-title">{c.levels.title}</h2>
      <p class="section-lead">{c.levels.lead}</p>

      <div class="levels">
        {c.levels.items.map((level) => (
          <div class="level">
            <div class="level-num">{level.num}</div>
            <div class="level-content">
              <div class="level-name">{level.name}</div>
              <div class="level-headline">{level.who}</div>
              <div class="level-desc"><span class="level-label">{c.labels.example}</span> {level.example}</div>
              <div class="level-desc level-sign"><span class="level-label">{c.labels.sign}</span> {level.sign}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section band reflection">
    <div class="container reflection-inner">
      <div class="eyebrow"><span class="marker marker--square" aria-hidden="true"></span>{c.thread.eyebrow}</div>
      <h2 class="h1 section-title">{c.thread.title}</h2>
      {c.thread.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <section class="section" id="method">
    <div class="container">
      <div class="eyebrow"><span class="marker marker--square" aria-hidden="true"></span>{c.method.eyebrow}</div>
      <h2 class="h1 section-title">{c.method.title}</h2>
      <p class="section-lead">{c.method.lead}</p>

      <ol class="steps">
        {c.method.steps.map((step, i) => (
          <li class="step">
            <div class="step-num">{i + 1}</div>
            <div class="step-content">
              <h3 class="step-title">{step.title}</h3>
              <p class="step-common">{step.common}</p>
              <div class="step-boxes">
                <div class="step-box step-box--main">
                  <div class="step-box-label">{c.labels[audience]}</div>
                  <p>{step[audience]}</p>
                </div>
                <div class="step-box step-box--other">
                  <div class="step-box-label">{c.labels[other]}</div>
                  <p>{step[other]}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <p class="cross-link"><a href={page.crossLink.href} class="more-link">{page.crossLink.text}</a></p>
    </div>
  </section>

  <section class="section sting">
    <div class="container">
      <p class="tagline sting-text" set:html={page.sting} />
    </div>
  </section>

  <div class="booking-section">
    <div class="container">
      <p>{page.booking}</p>
      <a href="https://app.cal.com/franksy/connect" class="btn btn-primary" data-cal-link="franksy/connect" data-cal-namespace="connect" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'>{c.labels.book}</a>
    </div>
  </div>
</Layout>
