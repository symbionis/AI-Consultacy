---
import Layout from '../layouts/Layout.astro';
import HeroShapes from '../components/HeroShapes.astro';
import { FRANK_REF, SITE, pageUrl } from '../i18n/ui';
import Doors from '../components/Doors.astro';
import FrameworkTeaser from '../components/FrameworkTeaser.astro';
import '../styles/home.css';
import '../styles/offer.css';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE}/#practice`,
  name: 'Franksy',
  url: pageUrl('en', ''),
  image: `${SITE}/og/home-en.png`,
  description: 'AI coaching for private clients and family offices, and AI agents for organisations.',
  email: 'frank@syks.co',
  areaServed: 'Worldwide',
  availableLanguage: ['en', 'fr'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Geneva',
    addressCountry: 'CH',
  },
  founder: FRANK_REF,
};
---

<Layout
  title="Franksy | A second mind for you, extra hands for your teams"
  description="AI shaped to the way you work. A second mind for private clients and family offices, extra hands for teams. Geneva, in English and French."
  locale="en"
  pathKey=""
  ogImage="/og/home-en.png"
  jsonLd={jsonLd}
>
  <main>
    <!-- Section 1: Hero (block) -->
    <section class="hero">
      <HeroShapes />
      <div class="container hero-inner">
        <div class="hero-text">
          <h1 class="display">A second mind for you. Extra hands for your teams.</h1>
          <p class="tagline">Less weight. More room.</p>
          <div class="cta-row">
            <a href="#what" class="btn btn-sun">See what this looks like</a>
          </div>
        </div>
      </div>
    </section>

    <!-- What this is (page) -->
    <section id="what" class="section">
      <div class="container">
        <hr class="bar" />
        <blockquote class="statement">
          I help people and teams bring AI into the way they already work. For you, a second mind to think with. For your teams, agents that carry the work that repeats.
        </blockquote>
        <div class="prose measure lede">
          <p>Not a course, and not a list of tools. We start from how you work today, shape AI around it, and I stay alongside until it is part of how you work.</p>
        </div>
      </div>
    </section>

    <!-- The framework (surface band) -->
    <section id="levels" class="section band">
      <div class="container">
        <FrameworkTeaser locale="en" />
      </div>
    </section>

    <!-- About Frank (page) -->
    <section class="section" id="about">
      <div class="container">
        <p class="eyebrow"><span class="marker marker--square" aria-hidden="true"></span>About Frank</p>
        <div class="teaser">
          <figure class="teaser-portrait">
            <img src="/frank-sykes.jpg" alt="Illustrated portrait of Frank Sykes" class="portrait-img" width="400" height="400" />
          </figure>
          <div class="prose measure">
            <p>Frank Sykes coaches entrepreneurs and small teams through the AI transition and deploys high impact solutions. He's been here before. In 1998, during the internet revolution, he built one of London's first online job-matching systems and watched the consultants who used it move from "this is going to take our job away" to, three months later, the opposite.</p>
            <p>Twenty years in London, then Geneva for his son. The technology has changed. The shape of what happens when it arrives hasn't.</p>
            <p><a href="/about/" class="more-link">The longer story →</a></p>
          </div>
        </div>
        <blockquote class="statement about-statement">
          After twenty-five years of running things, and the last few running them with AI, I have seen the same pattern every time. Fear first. A few months later, nobody wants to go back.
        </blockquote>
      </div>
    </section>

    <!-- Two doors (surface band) -->
    <section id="doors" class="section band">
      <div class="container">
        <Doors locale="en" />
      </div>
    </section>

    <!-- Closing (page) -->
    <section class="section closing">
      <div class="container">
        <p class="closing-text">Ready when you are.</p>
        <div class="cta-row">
          <a href="https://app.cal.com/franksy/connect" class="btn btn-primary" data-cal-link="franksy/connect" data-cal-namespace="connect" data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'>Book a 15-minute call</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
