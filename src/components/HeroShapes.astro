---
// The hero's shape cluster: arch (largest, the only one that drifts), sun
// circle beside it, scarlet dots small and low. Placed inside a `.hero` block;
// sizing and placement live in franksy.css. Decorative only.
---

<div class="hero-shapes" aria-hidden="true">
  <img class="shape shape-circle" src="/brand/circle-sun.svg" alt="" width="200" height="200" />
  <img class="shape shape-arch shape--drift" src="/brand/arch-scarlet.svg" alt="" width="200" height="200" />
  <img class="shape shape-dots" src="/brand/dots-scarlet.svg" alt="" width="200" height="200" />
</div>
