---
// Base layout for every page. Generates the full <head> — canonical, reciprocal
// hreflang alternates, Open Graph, Twitter, JSON-LD, fonts — from the i18n
// config and per-page props, so no page hand-writes head tags. Renders the
// shared Nav and Footer, and carries the language-preference script (lang.js).
//
// The Franksy design system (tokens, type, buttons, hero, nav, footer) lives in
// franksy.css, loaded here for every page. Pages import their own section
// stylesheet on top (home.css for home/about, framework.css for the framework
// pages); Astro injects the <link> into this <head>.
import '../styles/franksy.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CalFloatingButton from '../components/CalFloatingButton.astro';
import { ui, pageUrl, otherLocale, SITE, type Locale, type PathKey } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Locale-agnostic page identifier: '' (home), 'about', 'framework', 'private-clients', 'organisations'. */
  pathKey: PathKey;
  /** og:type — 'website' for most pages, 'article' for the framework pages. */
  ogType?: 'website' | 'article';
  /** Social preview image, a path under public/ (default: the homepage card). */
  ogImage?: string;
  /** JSON-LD structured data object, emitted verbatim into a ld+json script. */
  jsonLd: Record<string, unknown>;
}

const {
  title,
  description,
  locale,
  pathKey,
  ogType = 'website',
  ogImage: ogImagePath = '/og-image.png',
  jsonLd,
} = Astro.props;

const canonical = pageUrl(locale, pathKey);
const enUrl = pageUrl('en', pathKey);
const frUrl = pageUrl('fr', pathKey);
const ogLocale = ui[locale].ogLocale;
const ogLocaleAlternate = ui[otherLocale(locale)].ogLocale;
const ogImage = `${SITE}${ogImagePath}`;

// LinkedIn Insight Tag — the base pixel for ad conversion tracking. Inlined only
// when a partner ID is present at build time.
// The booking conversion itself is fired from CalFloatingButton via lintrk().
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID || null;
const linkedInSnippet = linkedInPartnerId
  ? `_linkedin_partner_id = ${JSON.stringify(linkedInPartnerId)};
window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
window._linkedin_data_partner_ids.push(_linkedin_partner_id);
(function(l){if(!l){window.lintrk=function(a,b){window.lintrk.q.push([a,b])};window.lintrk.q=[]}var s=document.getElementsByTagName("script")[0];var b=document.createElement("script");b.type="text/javascript";b.async=true;b.src="https://snap.licdn.com/li.lms-analytics/insight.min.js";s.parentNode.insertBefore(b,s);})(window.lintrk);`
  : null;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="/lang.js" defer is:inline></script>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd, null, 2)} />

    {linkedInSnippet && <script is:inline set:html={linkedInSnippet} />}
    {
      linkedInPartnerId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none;"
            alt=""
            src={`https://px.ads.linkedin.com/collect/?pid=${linkedInPartnerId}&fmt=gif`}
          />
        </noscript>
      )
    }

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..600;1,400..600&family=Instrument+Serif:ital@1&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body>
    <Nav locale={locale} pathKey={pathKey} />
    <slot />
    <Footer locale={locale} pathKey={pathKey} />
    <CalFloatingButton locale={locale} />
  </body>
</html>
